// base.kdl — shared Niri behavior + binds

input {
  // Keyboard-first: use Mod (Super on TTY, Alt when nested)
  // You can customize Mod mapping if you want later.
  // See niri key binding docs.

  touchpad {
    tap
    natural-scroll
  }

  mouse {
    // Leave defaults unless you want to tweak accel later.
    // accel-profile "flat"
    // accel-speed 0.2
  }
}

// Prefer to keep binds in one place and re-use them via include.
// Niri supports include splitting.

binds {
  // --- Launchers ---
  Mod+Return { spawn "wezterm"; }   // change to your terminal
  Mod+D      { spawn "fuzzel"; }      // if you use a launcher; swap later if DMS/Noctalia provides one

  // --- Window management ---
  Mod+Q       { close-window; }
  Mod+Escape  { toggle-keyboard-shortcuts-inhibit; } // escape hatch

  // --- Focus movement (vim-ish + arrows) ---
  Mod+H { focus-column-left; }
  Mod+L { focus-column-right; }
  Mod+J { focus-window-down; }
  Mod+K { focus-window-up; }

  Mod+Left  { focus-column-left; }
  Mod+Right { focus-column-right; }
  Mod+Down  { focus-window-down; }
  Mod+Up    { focus-window-up; }

  // --- Move windows around ---
  Mod+Shift+H { move-column-left; }
  Mod+Shift+L { move-column-right; }
  Mod+Shift+J { move-window-down; }
  Mod+Shift+K { move-window-up; }

  // --- Workspaces ---
  Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

  // Optional: numeric workspaces if you want them.
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
}
